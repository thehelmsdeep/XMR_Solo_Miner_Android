# Reference only: config.py provides defaults; this file is not loaded automatically.
# To override settings, export environment variables in your shell.
# Public Monero receiving address only; never put seed phrases or private keys here.
XMR_WALLET_ADDRESS=45YfAsuTdSjSo2rw5ov137A8Y6TdY6pY3Z5ZWQa6oX28A1ysnbjBsWxc7nFxB3hWH73e318AQD7c7MYXXkL7CpMn3UBEYu2

MINING_MODE=pool
CPU_THREADS=8
# auto, fast, or light. Light uses much less RAM and is the default for Android.
RANDOMX_MODE=light
XMRIG_PATH=/data/data/com.termux/files/home/xmrig/build/xmrig

P2POOL_STRATUM_HOST=127.0.0.1
P2POOL_STRATUM_PORT=3333

POOL_HOST=xmrpool.eu
POOL_PORT=3333
POOL_TLS=true

# Solo mode only: a separate, fully synchronized monerod must be running.
# Keep RPC bound to localhost; do not expose unauthenticated RPC publicly.
MONERO_RPC_HOST=127.0.0.1
MONERO_RPC_PORT=18081
LOG_LEVEL=INFO
