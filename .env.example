# Public Monero receiving address only; never put seed phrases or private keys here
XMR_WALLET_ADDRESS=45YfAsuTdSjSo2rw5ov137A8Y6TdY6pY3Z5ZWQa6oX28A1ysnbjBsWxc7nFxB3hWH73e318AQD7c7MYXXkL7CpMn3UBEYu2

# Select p2pool, pool, or solo
MINING_MODE=p2pool
CPU_THREADS=2
XMRIG_PATH=xmrig

# P2Pool's local Stratum endpoint (used only with MINING_MODE=p2pool)
P2POOL_STRATUM_HOST=127.0.0.1
P2POOL_STRATUM_PORT=3333

# Standard Monero pool endpoint (required with MINING_MODE=pool).
# Set these to the hostname and port published by the pool you choose.
POOL_HOST=
POOL_PORT=0

# Monero daemon RPC endpoint (used only with MINING_MODE=solo)
MONERO_RPC_HOST=127.0.0.1
MONERO_RPC_PORT=18081
LOG_LEVEL=INFO
